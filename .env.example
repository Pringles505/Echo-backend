# =============================================================================
# Echo Backend — Environment Variables Example
# =============================================================================
# Copy this file to `.env` (production/local) and `.env.test` (test runs).
# Never commit secrets. The values shown here are sane defaults; replace
# JWT_SECRET and MONGO_URI before deploying anywhere user data exists.
#
# Categories below mirror src/shared/constants.js. Anything you don't set
# here falls back to the defaults baked into constants.js.

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Primary connection string. MONGO_URI_SECRET is read as a fallback when
# MONGO_URI is empty (useful for cloud secret managers).
MONGO_URI=mongodb://127.0.0.1:27017/echo-dev
# MONGO_URI_SECRET=
# Used by the test runner instead of MONGO_URI when present.
# MONGO_URI_TEST=mongodb://127.0.0.1:27017/echo-test

# -----------------------------------------------------------------------------
# Auth / JWT
# -----------------------------------------------------------------------------
# JWT signing secret. Required to start the server outside of tests. Must be
# >= 32 random bytes in production (`openssl rand -hex 32`).
JWT_SECRET=replace-me-with-a-strong-secret

# Lifetimes accepted by jsonwebtoken (e.g. "1h", "30d", "900s").
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=30d
JWT_DEVICE_TTL=30d
# Refresh-token bytes of entropy (hex output is 2x this length).
REFRESH_TOKEN_BYTES=64
# Bcrypt cost factor for hashing user passwords.
BCRYPT_SALT_ROUNDS=10

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Comma-separated list of explicit origins allowed in BOTH dev and production.
# When unset:
#   - production: only the curated Vercel + tauri origins (see constants.js)
#   - development: any origin (true)
# Use this to add LAN URLs, staging hosts, etc.
# CORS_ALLOWED_ORIGINS=https://chat.example.com,https://staging.example.com
# Legacy alias still supported.
# CORS_EXTRA_ORIGINS=

# -----------------------------------------------------------------------------
# Socket.IO
# -----------------------------------------------------------------------------
SOCKET_PING_INTERVAL_MS=25000
SOCKET_PING_TIMEOUT_MS=60000

# -----------------------------------------------------------------------------
# HTTP body limits
# -----------------------------------------------------------------------------
JSON_LIMIT=15mb
TEXT_LIMIT=15mb

# -----------------------------------------------------------------------------
# Pairing (primary-device approval flow)
# -----------------------------------------------------------------------------
# Total pairing session lifetime in milliseconds.
PAIRING_SESSION_TTL_MS=300000
# Number of characters in the human-readable pairing code (>= 8 alphanumeric).
PAIRING_CODE_LENGTH=8
# Reserved for future per-session attempt limits (not currently enforced).
PAIRING_MAX_ATTEMPTS=5

# -----------------------------------------------------------------------------
# Device sync (QR / scanner DH flow)
# -----------------------------------------------------------------------------
SYNC_SESSION_TTL_MS=90000
SYNC_SESSION_MAX_TTL_MS=120000
SYNC_CHUNK_MAX_SIZE=262144
SYNC_CHUNK_MAX_COUNT=256
SYNC_MAX_TOTAL_BYTES=33554432

# -----------------------------------------------------------------------------
# Device envelopes (per-device fanout outbox)
# -----------------------------------------------------------------------------
DEVICE_ENVELOPE_TTL_SECONDS=604800
DEVICE_MAX_PER_USER=10
# Max envelopes a single sender can store per minute (basic flood control).
RATE_LIMIT_ENVELOPES_PER_MIN=120

# -----------------------------------------------------------------------------
# OPK (One-time pre-key) policy
# -----------------------------------------------------------------------------
OPK_LOW_WATERMARK=50
OPK_TARGET_COUNT=100
OPK_MAX_STORED=500
OPK_UPLOAD_MAX=200
OPK_REQUEST_LOG_TTL_SECONDS=2592000

# -----------------------------------------------------------------------------
# Rate limits (used by express-rate-limit)
# -----------------------------------------------------------------------------
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_REFRESH_PER_MIN=30
RATE_LIMIT_PAIRING_PER_MIN=30
RATE_LIMIT_SYNC_CREATE_PER_MIN=10
RATE_LIMIT_SYNC_ATTACH_PER_MIN=20

# -----------------------------------------------------------------------------
# File uploads
# -----------------------------------------------------------------------------
PROFILE_PICTURE_MAX_SIZE=5000000
BANNER_MAX_SIZE=8000000
UPLOADS_DIR=uploads

# -----------------------------------------------------------------------------
# Argon2 (NOT USED for password hashing — backend receives hashes already
# derived client-side via Argon2id in ELD. These vars are reserved in case
# server-side Argon2 is added; bcrypt is the current production code path.)
# -----------------------------------------------------------------------------
ARGON2_MEM=131072
ARGON2_TIME=4
ARGON2_PARALLELISM=1
