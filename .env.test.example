## Echo-backend test environment
#
# Copy this file to `.env.test` (do not commit `.env.test`) and fill in values.
#
# Use a local MongoDB instance:
# MONGO_URI_TEST=mongodb://127.0.0.1:27017/echo_test
#
# Or use MongoDB Atlas (URL-encode special characters in username/password):
# MONGO_URI_TEST=mongodb+srv://USER:PASS@cluster0.example.mongodb.net/echo_test?retryWrites=true&w=majority

MONGO_URI=mongodb://127.0.0.1:27017/echo_test
JWT_SECRET=test-secret
